+def test_optional_demo_token_is_accepted_alongside_the_operator_token(monkeypatch) -> None:
+    monkeypatch.setenv("TRAFFIX_OPERATOR_TOKEN", "test-secret")
+    monkeypatch.setenv("TRAFFIX_REQUIRE_OPERATOR_TOKEN", "1")
+    monkeypatch.delenv("TRAFFIX_DEMO_TOKEN", raising=False)
+    with pytest.raises(HTTPException):
+        require_operator("Bearer recruiter-code")
+    monkeypatch.setenv("TRAFFIX_DEMO_TOKEN", "recruiter-code")
+    require_operator("Bearer recruiter-code")
+    require_operator("Bearer test-secret")
